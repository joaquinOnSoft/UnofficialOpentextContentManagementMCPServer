# --------------------------------------
# OpenText Content Management connection
# --------------------------------------
# Content Server URL; the REST API is served under <OTCS_BASE_URL>/api
OTCS_BASE_URL=https://otcs.example.com/cs/cs   
OTCS_USERNAME=service_user
OTCS_PASSWORD=change_me
OTCS_VERIFY_SSL=true
OTCS_TIMEOUT_SECONDS=30
# maximum parallel requests to OpenText
OTCS_MAX_CONCURRENCY=8              
# retries for idempotent (read) requests only
OTCS_MAX_RETRIES=2                  

# ----------
# MCP server
# ----------
# stdio | http
MCP_TRANSPORT=stdio                  
MCP_HOST=0.0.0.0
MCP_PORT=8443
# HTTP Basic credentials for the HTTP transport
MCP_HTTP_AUTH_USER=mcp_user          
MCP_HTTP_AUTH_PASSWORD=change_me
# disables write tools
MCP_READ_ONLY=true                   
MCP_MAX_RESPONSE_ITEMS=50
# maximum bytes of document text returned per call
MCP_MAX_CONTENT_BYTES=100000         
MCP_MAX_UPLOAD_BYTES=50000000
# Host header allowlist (DNS rebinding protection): add the name clients use, e.g. mcp.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   
# comma-separated allowlist for the Origin header (empty = reject any request that sends an Origin)
MCP_ALLOWED_ORIGINS=                 
# maximum request body size
MCP_MAX_BODY_BYTES=1048576           
# per client IP address, applied before authentication (0 disables the limit)
MCP_RATE_LIMIT_PER_MINUTE=120        
# exposes /metrics (Basic Auth required) when true
MCP_METRICS_ENABLED=false            
LOG_LEVEL=INFO
# json | text (logs always go to stderr)
LOG_FORMAT=json                      

# --------------------
# TLS (HTTP transport)
# --------------------
TLS_ENABLED=true
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
# generate a self-signed cert if none exists
TLS_AUTO_GENERATE=true               
TLS_CERT_CN=localhost
TLS_CERT_SAN=DNS:localhost,IP:127.0.0.1
TLS_CERT_DAYS=365
