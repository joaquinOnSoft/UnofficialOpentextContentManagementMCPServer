# OpenText Content Management connection
OTCS_BASE_URL=https://otcs.example.com/cs/cs   # Content Server URL; the REST API is served under <OTCS_BASE_URL>/api
OTCS_USERNAME=service_user
OTCS_PASSWORD=change_me
OTCS_VERIFY_SSL=true
OTCS_TIMEOUT_SECONDS=30
OTCS_MAX_CONCURRENCY=8              # maximum parallel requests to OpenText
OTCS_MAX_RETRIES=2                  # retries for idempotent (read) requests only

# MCP server
MCP_TRANSPORT=stdio                  # stdio | http
MCP_HOST=0.0.0.0
MCP_PORT=8443
MCP_HTTP_AUTH_USER=mcp_user          # HTTP Basic credentials for the HTTP transport
MCP_HTTP_AUTH_PASSWORD=change_me
MCP_READ_ONLY=true                   # disables write tools
MCP_MAX_RESPONSE_ITEMS=50
MCP_MAX_CONTENT_BYTES=100000         # maximum bytes of document text returned per call
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]   # Host header allowlist (DNS rebinding protection): add the name clients use, e.g. mcp.example.com
MCP_ALLOWED_ORIGINS=                 # comma-separated allowlist for the Origin header (empty = reject any request that sends an Origin)
MCP_MAX_BODY_BYTES=1048576           # maximum request body size
MCP_RATE_LIMIT_PER_MINUTE=120        # per client IP address, applied before authentication (0 disables the limit)
MCP_METRICS_ENABLED=false            # exposes /metrics (Basic Auth required) when true
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | text (logs always go to stderr)

# TLS (HTTP transport)
TLS_ENABLED=true
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
TLS_AUTO_GENERATE=true               # generate a self-signed cert if none exists
TLS_CERT_CN=localhost
TLS_CERT_SAN=DNS:localhost,IP:127.0.0.1
TLS_CERT_DAYS=365
